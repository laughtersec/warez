		},
		{
			"id":"009cf319353fd362",
			"type":"text",
			"text":"Exported DLL Function",
			"styleAttributes":{"textAlign":"center"},
			"x":-340,
			"y":140,
			"width":180,
			"height":60
		},
		{
			"id":"d86fd91796c9a0aa",
			"type":"text",
			"text":"# Hooking\n\n1. Main calls hookSleep()\n2. hookSleep() modifies `SleepEx` and prepends trampoline function\n\nHenceforth, any call to `SleepEx` will be redirected to the locally defined `MySleep` function, unless unhooked.",
			"styleAttributes":{
				"textAlign":null
			},
			"x":120,
			"y":280,
			"width":520,
			"height":250
		},
		{
			"id":"35f5c1c3e4e0f1e5",
			"type":"text",
			"text":"MySleep()",
			"styleAttributes":{"textAlign":"center"},
			"x":-340,
			"y":440,
			"width":360,
			"height":60
		},
		{
			"id":"7981905014972b96",
			"type":"text",
			"text":"malware.exe",
			"styleAttributes":{"textAlign":"center"},
